# Web
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Core services (SQLite works out of the box; use PostgreSQL in Docker)
DATABASE_URL=sqlite:///./clipforge.db
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000

# AI routing. "local" runs the deterministic development planner without keys.
CLIPFORGE_AI_MODE=local
OPENAI_API_KEY=
OPENAI_DIRECTOR_MODEL=gpt-5.6-terra
OPENAI_WORKER_MODEL=gpt-5.6-luna
OPENAI_ESCALATION_MODEL=gpt-5.6-sol

# Research and media
BRAVE_SEARCH_API_KEY=
PEXELS_API_KEY=
# Optional free real-media provider; skipped silently when empty.
PIXABAY_API_KEY=

# Visual Director V2: paid AI image fallback, used only after free real media
# fails the quality gate. Uses OPENAI_API_KEY; bounded per project and scene.
GENERATED_IMAGE_FALLBACK_ENABLED=true
GENERATED_IMAGE_MODEL=gpt-image-2
GENERATED_IMAGE_QUALITY=low
MAX_AUTO_GENERATED_IMAGES_PER_PROJECT=3
MAX_GENERATION_ATTEMPTS_PER_SCENE=1
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=clipforge

# YouTube Learning Loop: Google OAuth client for the local browser sign-in.
# Can also be saved from Settings > Integrations > YouTube (stored in the OS
# keychain). The channel's refresh token is only ever kept in the keychain.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:8000/api/youtube/oauth/callback
# Minimum comparable ClipForge Shorts before any "above/below baseline" claim.
YOUTUBE_BASELINE_MIN_SAMPLE=5

# Topic Intelligence (Generate Next Video): candidate pool reuse, the YouTube quota
# budget of one discovery refresh (search.list = 100 units), the number of competition
# searches per refresh, and optional JSON weight overrides for the scoring authority.
TOPIC_POOL_TTL_MINUTES=45
TOPIC_YOUTUBE_QUOTA_BUDGET=400
TOPIC_YOUTUBE_SEARCH_PROBES=2
TOPIC_SCORE_WEIGHTS=
# AI curation of topic suggestions (question + semantic judgement in one call). Uses OPENAI_API_KEY
# independently of CLIPFORGE_AI_MODE; off or no key -> strict local rules, fewer suggestions.
TOPIC_SEMANTIC_VALIDATION=true
# Topics per curator request (3 requests per pool); smaller = faster, less likely to time out.
TOPIC_CURATOR_BATCH_SIZE=10

# Optional production providers
GEMINI_API_KEY=
SENTRY_DSN=

